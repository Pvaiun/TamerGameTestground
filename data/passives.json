{
  "_format": "Each passive: { name, desc, triggers:[{on,if?,effect,consumesOn?}] }. Passives are grouped loosely by archetype theme — Striker (offensive), Warden (defensive), Weaver (status), Keeper (sustain).",

  "brutal": {
    "name": "Brutal",
    "desc": "+25% damage on your first action each round.",
    "triggers": [
      { "on": "power_query", "if": { "firstAttackThisRound": true }, "effect": { "type": "power_mult", "value": 1.25 } }
    ]
  },
  "predators_edge": {
    "name": "Predator's edge",
    "desc": "+40% damage to enemies below 50% hp.",
    "triggers": [
      { "on": "power_query", "if": { "targetHpFrac": "<0.5" }, "effect": { "type": "power_mult", "value": 1.4 } }
    ]
  },
  "cornered": {
    "name": "Cornered",
    "desc": "Below 35% hp: +50% damage.",
    "triggers": [
      { "on": "power_query", "if": { "selfHpFrac": "<0.35" }, "effect": { "type": "power_mult", "value": 1.5 } }
    ]
  },
  "swift": {
    "name": "Swift",
    "desc": "+30% speed.",
    "triggers": [
      { "on": "stat_query", "if": { "queryStat": "spd" }, "effect": { "type": "stat_mult", "stat": "spd", "value": 1.3 } }
    ]
  },
  "glass_cannon": {
    "name": "Glass cannon",
    "desc": "+50% atk, -30% def.",
    "triggers": [
      { "on": "stat_query", "if": { "queryStat": "atk" }, "effect": { "type": "stat_mult", "stat": "atk", "value": 1.5 } },
      { "on": "stat_query", "if": { "queryStat": "def" }, "effect": { "type": "stat_mult", "stat": "def", "value": 0.7 } }
    ]
  },
  "savage": {
    "name": "Savage",
    "desc": "Crits deal +40% extra damage.",
    "triggers": [
      { "on": "crit_query", "effect": { "type": "crit_mult", "value": 2.0 } }
    ]
  },
  "lucky": {
    "name": "Lucky",
    "desc": "Crit chance is doubled (10% → 20%).",
    "triggers": [
      { "on": "crit_query", "effect": { "type": "crit_chance_set", "value": 0.20 } }
    ]
  },
  "tempo": {
    "name": "Tempo",
    "desc": "+25% damage while faster than opponent.",
    "triggers": [
      { "on": "power_query", "if": { "selfFasterThanTarget": true }, "effect": { "type": "power_mult", "value": 1.25 } }
    ]
  },

  "stone_skin": {
    "name": "Stone skin",
    "desc": "Take 3 less damage from every hit (min 1).",
    "triggers": [
      { "on": "defense_query", "effect": { "type": "flat_dmg_reduction", "value": 3 } }
    ]
  },
  "bulwark": {
    "name": "Bulwark",
    "desc": "Take 25% less damage from non-elemental attacks.",
    "triggers": [
      { "on": "defense_query", "effect": { "type": "non_elem_dmg_mult", "value": 0.75 } }
    ]
  },
  "iron_grip": {
    "name": "Iron grip",
    "desc": "+20% atk and +20% def.",
    "triggers": [
      { "on": "stat_query", "if": { "queryStat": "atk" }, "effect": { "type": "stat_mult", "stat": "atk", "value": 1.2 } },
      { "on": "stat_query", "if": { "queryStat": "def" }, "effect": { "type": "stat_mult", "stat": "def", "value": 1.2 } }
    ]
  },
  "thick_hide": {
    "name": "Thick hide",
    "desc": "Heal 30% max hp at battle start.",
    "triggers": [
      { "on": "battle_start", "effect": { "type": "heal_self", "percent": 0.30 } }
    ]
  },
  "riposte": {
    "name": "Riposte",
    "desc": "When hit, deal 20% of damage taken back.",
    "triggers": [
      { "on": "hit_taken", "effect": { "type": "reflect_damage", "percent": 0.20 } }
    ]
  },
  "reflective_aura": {
    "name": "Reflective aura",
    "desc": "Reflect 12% of all damage taken.",
    "triggers": [
      { "on": "hit_taken", "effect": { "type": "reflect_damage", "percent": 0.12 } }
    ]
  },
  "warm_blood": {
    "name": "Warm-blooded",
    "desc": "Immune to Fevering. Heals you receive are +20% stronger.",
    "triggers": [
      { "on": "status_block", "effect": { "type": "block_statuses", "statuses": ["burn"] } },
      { "on": "heal_query", "effect": { "type": "heal_mult", "value": 1.2 } }
    ]
  },
  "iron_will": {
    "name": "Iron will",
    "desc": "Immune to Drained, Sedated, and Broken.",
    "triggers": [
      { "on": "status_block", "effect": { "type": "block_statuses", "statuses": ["soaking", "dazed", "cursed"] } }
    ]
  },

  "pyromancer": {
    "name": "Pyromancer",
    "desc": "+40% damage to Fevering targets.",
    "triggers": [
      { "on": "power_query", "if": { "targetHasStatus": "burn" }, "effect": { "type": "power_mult", "value": 1.4 } }
    ]
  },
  "curse_weaver": {
    "name": "Curse weaver",
    "desc": "On hit, 30% chance to also apply Sedated.",
    "triggers": [
      { "on": "hit_dealt", "effect": { "type": "apply_status", "status": "dazed", "target": "enemy", "chance": 0.30 } }
    ]
  },
  "status_lord": {
    "name": "Status lord",
    "desc": "+25% damage per unique status on the target.",
    "triggers": [
      { "on": "power_query", "effect": { "type": "power_mult_per_status", "perStatus": 0.25 } }
    ]
  },
  "frostbite": {
    "name": "Frostbite",
    "desc": "When you land an attack, target loses 10% spd (stacking).",
    "triggers": [
      { "on": "hit_dealt", "effect": { "type": "buff_target", "statMods": { "spd": -0.10 } } }
    ]
  },
  "poisonous": {
    "name": "Poisonous",
    "desc": "On hit, 25% chance to apply Drained.",
    "triggers": [
      { "on": "hit_dealt", "effect": { "type": "apply_status", "status": "soaking", "target": "enemy", "chance": 0.25 } }
    ]
  },
  "hex_eater": {
    "name": "Hex eater",
    "desc": "Cleanse one debuff at start of each round.",
    "triggers": [
      { "on": "round_start", "effect": { "type": "cleanse_self_step", "step": 0.15 } }
    ]
  },
  "serene": {
    "name": "Serene",
    "desc": "Immune to Sedated. Cleanses self of one status at battle start.",
    "triggers": [
      { "on": "status_block", "effect": { "type": "block_statuses", "statuses": ["dazed"] } },
      { "on": "battle_start", "effect": { "type": "cleanse_self_step", "step": 0.15 } }
    ]
  },
  "echo_form": {
    "name": "Echo form",
    "desc": "Each round, gain +10% atk and +10% def for that round.",
    "triggers": [
      { "on": "round_start", "effect": { "type": "buff_self", "statMods": { "atk": 0.10, "def": 0.10 }, "turns": 1 } }
    ]
  },

  "photosynthesis": {
    "name": "Photosynthesis",
    "desc": "Heal 7% max hp at start of each round.",
    "triggers": [
      { "on": "round_start", "effect": { "type": "heal_self", "percent": 0.07 } }
    ]
  },
  "soul_drain": {
    "name": "Soul drain",
    "desc": "Heal 22% of damage you deal.",
    "triggers": [
      { "on": "hit_dealt", "effect": { "type": "heal_self_pct_dmg", "percent": 0.22 } }
    ]
  },
  "blooming": {
    "name": "Blooming",
    "desc": "Heals you do (and receive) are +35% stronger.",
    "triggers": [
      { "on": "heal_query", "effect": { "type": "heal_mult", "value": 1.35 } }
    ]
  },
  "vampire_touch": {
    "name": "Vampire touch",
    "desc": "Heals received are +25% stronger; cap is 120% max hp.",
    "triggers": [
      { "on": "heal_query", "effect": { "type": "heal_mult", "value": 1.25 } },
      { "on": "heal_query", "effect": { "type": "overheal_cap", "value": 1.2 } }
    ]
  },
  "sentinel": {
    "name": "Sentinel",
    "desc": "While on bench, heal 7% max hp per round.",
    "triggers": [
      { "on": "bench_tick", "effect": { "type": "heal_self", "percent": 0.07 } }
    ]
  },
  "second_wind": {
    "name": "Second wind",
    "desc": "On swap-in, heal 22% max hp.",
    "triggers": [
      { "on": "swap_in", "effect": { "type": "heal_self", "percent": 0.22 } }
    ]
  },
  "vanguard": {
    "name": "Vanguard",
    "desc": "On swap-in, gain +30% atk for 2 rounds.",
    "triggers": [
      { "on": "swap_in", "effect": { "type": "buff_self", "statMods": { "atk": 0.30 }, "turns": 2 } }
    ]
  },
  "lightbearer_pulse": {
    "name": "Lightbearer",
    "desc": "When you spend Tend, also +20% atk for 1 round.",
    "triggers": [
      { "on": "tend_spent", "effect": { "type": "buff_self", "statMods": { "atk": 0.20 }, "turns": 1 } }
    ]
  }
}
