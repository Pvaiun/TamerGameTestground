{
  "_format": "12 distinct passives. Each does one clear thing. Avoid overlap. Each species has 1 passive defined in templates.json (primaryPassive). Breeding can mix.",

  "vanguard": {
    "name": "Vanguard",
    "desc": "+30% atk for the first two rounds of battle.",
    "triggers": [
      { "on": "battle_start", "effect": { "type": "buff_self", "statMods": { "atk": 0.30 }, "turns": 2 } }
    ]
  },

  "sentinel": {
    "name": "Sentinel",
    "desc": "Take 25% less damage on round 1. Heals 8% max hp on bench each round.",
    "triggers": [
      { "on": "defense_query", "if": { "round": 1 }, "effect": { "type": "incoming_mult", "value": 0.75 } },
      { "on": "bench_tick", "effect": { "type": "heal_self", "percent": 0.08 } }
    ]
  },

  "brutal": {
    "name": "Brutal",
    "desc": "Your first attack each round deals +25% damage.",
    "triggers": [
      { "on": "power_query", "if": { "firstAttackThisRound": true }, "effect": { "type": "power_mult", "value": 1.25 } }
    ]
  },

  "swift": {
    "name": "Swift",
    "desc": "+30% speed. Win speed ties.",
    "triggers": [
      { "on": "stat_query", "if": { "queryStat": "spd" }, "effect": { "type": "stat_mult", "stat": "spd", "value": 1.30 } },
      { "on": "tie_break", "effect": { "type": "tie_break_win" } }
    ]
  },

  "stone_skin": {
    "name": "Stone Skin",
    "desc": "Take 3 less damage from every hit (min 1).",
    "triggers": [
      { "on": "defense_query", "effect": { "type": "flat_dmg_reduction", "value": 3 } }
    ]
  },

  "glass_cannon": {
    "name": "Glass cannon",
    "desc": "+50% atk. Take +25% damage.",
    "triggers": [
      { "on": "stat_query", "if": { "queryStat": "atk" }, "effect": { "type": "stat_mult", "stat": "atk", "value": 1.50 } },
      { "on": "defense_query", "effect": { "type": "incoming_mult", "value": 1.25 } }
    ]
  },

  "predator": {
    "name": "Predator",
    "desc": "+50% damage to enemies below 50% hp.",
    "triggers": [
      { "on": "power_query", "if": { "targetHpFrac": "<0.5" }, "effect": { "type": "power_mult", "value": 1.50 } }
    ]
  },

  "crit_lord": {
    "name": "Crit Lord",
    "desc": "+25% crit chance. Crits deal +0.5×.",
    "triggers": [
      { "on": "crit_query", "effect": { "type": "crit_chance_set", "value": 0.30 } },
      { "on": "crit_query", "effect": { "type": "crit_mult_add", "value": 0.5 } }
    ]
  },

  "vampire": {
    "name": "Vampire",
    "desc": "Heal 25% of damage dealt.",
    "triggers": [
      { "on": "hit_dealt", "effect": { "type": "heal_self_pct_dmg", "percent": 0.25 } }
    ]
  },

  "pyromancer": {
    "name": "Pyromancer",
    "desc": "+40% damage vs Fevering targets.",
    "triggers": [
      { "on": "power_query", "if": { "targetHasStatus": "burn" }, "effect": { "type": "power_mult", "value": 1.40 } }
    ]
  },

  "lightbearer": {
    "name": "Lightbearer",
    "desc": "Start each battle with 1 Charge. Spend abilities deal +20% extra dmg.",
    "triggers": [
      { "on": "battle_start", "effect": { "type": "grant_charge", "amount": 1 } },
      { "on": "power_query", "if": { "abilityHasTag": "spend" }, "effect": { "type": "power_mult", "value": 1.20 } }
    ]
  },

  "hex_eater": {
    "name": "Hex-eater",
    "desc": "Immune to Brittle and Stun. Cleanse 1 debuff at start of each round.",
    "triggers": [
      { "on": "status_block", "effect": { "type": "block_statuses", "statuses": ["brittle", "stun"] } },
      { "on": "round_start", "effect": { "type": "cleanse_self_step" } }
    ]
  }
}
